# Gemini is the default provider at startup (falls back to OpenRouter if
# only OPENROUTER_API_KEY is set). Switch providers at runtime with /model
# instead of an env var — set whichever key(s) below you plan to use.

# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
